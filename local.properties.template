# Copy this file to local.properties and fill in the values.
# local.properties is gitignored and never committed.

## Android SDK (set automatically by Android Studio)
#sdk.dir=/Users/<you>/Library/Android/sdk

## Privacy mode at first launch (MODE_BEST | MODE_OFFLINE)
## Omit to default to MODE_BEST.
#PRIVACY_MODE=MODE_BEST

## Wrait backend — speech-to-text proxy, cleanup proxy, and device registration
## PROXY_SECRET is required for cloud transcription / cleanup to work.
## Omit BACKEND_URL to use the default production URL.
#BACKEND_URL=https://wrait-backend.vercel.app
PROXY_SECRET=

## Dev mode (true | false)
## When true, entry cards show draft text under cleaned text for debugging.
#DEV=false

## Release signing (optional — debug builds work without these)
#KEYSTORE_PATH=/path/to/release.jks
#KEYSTORE_PASSWORD=
#KEY_ALIAS=
#KEY_PASSWORD=
