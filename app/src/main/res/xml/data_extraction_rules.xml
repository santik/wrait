<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Privacy: exclude all user content and local secrets from cloud backup. -->

        <!-- Room (SQLCipher) diary database -->
        <exclude domain="database" path="wrait_db"/>
        <exclude domain="database" path="wrait_db-wal"/>
        <exclude domain="database" path="wrait_db-shm"/>

        <!-- DataStore (preferences) -->
        <exclude domain="file" path="datastore/wrait_preferences.preferences_pb"/>

        <!-- Audio-only drafts (Whisper backend) -->
        <exclude domain="file" path="audio_drafts"/>

        <!-- DB encryption material (Tink keyset + encrypted SQLCipher password) -->
        <exclude domain="sharedpref" path="wrait_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Same exclusions for device-to-device transfer (e.g., cable setup). -->

        <exclude domain="database" path="wrait_db"/>
        <exclude domain="database" path="wrait_db-wal"/>
        <exclude domain="database" path="wrait_db-shm"/>

        <exclude domain="file" path="datastore/wrait_preferences.preferences_pb"/>
        <exclude domain="file" path="audio_drafts"/>
        <exclude domain="sharedpref" path="wrait_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
